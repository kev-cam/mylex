+          && strcmp(istr(tree_ident(t)), "\"&\"") == 0) {
+         if (sn + 2 > scap) {
+            scap *= 2;
+            stk = xrealloc_array(stk, scap, sizeof(tree_t));
+         }
+         stk[sn++] = tree_value(tree_param(t, 1));   // popped second
+         stk[sn++] = tree_value(tree_param(t, 0));
+         continue;
+      }
+      if (n == cap) {
+         cap *= 2;
+         leaf = xrealloc_array(leaf, cap, sizeof(tree_t));
+      }
+      leaf[n++] = t;
+   }
+   free(stk);
