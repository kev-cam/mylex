+   char **ls = xmalloc_array(n, sizeof(char *));
+   int *lw = xmalloc_array(n, sizeof(int));
+   bool ok = true;
+   size_t total = 0;
+   for (int i = 0; i < n; i++)
+      ls[i] = NULL;
+   for (int i = 0; ok && i < n; i++) {
+      char buf[R2_SPEC];
+      ok = r2_expr(leaf[i], buf, sizeof buf);
+      if (ok) {
+         lw[i] = r2_width_or_operands(leaf[i]);
+         if (lw[i] < 1)
