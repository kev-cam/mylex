# baseline: sv2v-flattened Vortex Verilog straight into Yosys (as Vortex's own flow does)
read_verilog -sv /tmp/claude-1002/-home-claude/50726f3c-29a3-493b-90a6-ca98ad342bc6/scratchpad/exec_final/exec.v
hierarchy -check -top exec_top
proc; flatten; opt -full; wreduce; opt_clean
stat -width
write_rtlil exec.baseline.il
synth -top exec_top -flatten
abc -g AND,NAND,OR,NOR,XOR,XNOR,MUX
opt_clean
stat -width
write_rtlil exec.gates.il
write_verilog -noattr exec.gates.v
