+         return folded_int(a, &x) && folded_int(b, &y) && x == y;
+      }
+   case T_FCALL:
+   case T_ARRAY_REF:
+      {
+         if (tree_kind(a) == T_FCALL
+             ? tree_ident(a) != tree_ident(b)
+             : !r2_tree_same(tree_value(a), tree_value(b)))
+            return false;
