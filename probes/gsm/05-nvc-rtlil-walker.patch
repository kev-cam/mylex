+      snprintf(out, sz, "%d'd%llu", w,
+               (unsigned long long)(v & ((1ULL << w) - 1)));
+      return true;
+   }
+   if (tick[1] == 'b') {
+      const char *dig = tick + 2;
+      const int nd = (int)strlen(dig);
+      if ((size_t)w + 8 > sz)
+         return false;
+      char *p = out + snprintf(out, sz, "%d'b", w);
+      for (int i = w - 1; i >= 0; i--)
+         *p++ = i < nd ? dig[nd - 1 - i] : '0';
+      *p = '\0';
+      return true;
+   }
+   return false;
