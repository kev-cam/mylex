+      // Candidates grouped by sensitivity set, in source order.
+      std::map<std::string, std::vector<pending_edge_t*> > by_key;
+      std::vector<std::string> key_order;
+      for (pending_edge_t *m : members) {
+         m->sigs = written_signals(m->proc, ent);
