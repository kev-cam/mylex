proc dump_endpoints {fh tag} {
  foreach p [get_pins -of_objects [all_registers] -filter "direction == input"] {
    set s ""
    catch {set s [get_property $p slack_max]}
    if {$s ne ""} { puts $fh "EP $tag [get_full_name $p] $s" }
  }
  foreach p [all_outputs] {
    set s ""
    catch {set s [get_property $p slack_max]}
    if {$s ne ""} { puts $fh "EP $tag [get_full_name $p] $s" }
  }
}
